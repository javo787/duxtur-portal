{
  "name": "duxtur-render-service",
  "version": "2.0.0",
  "private": true,
  "description": "Always-on сервис Duxtur.org на Render: вебхуки Telegram-ботов и рендер PDF/PNG-визиток в headless Chrome. Всё, что не должно жить в serverless-функциях Vercel.",
  "main": "dist/server.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node smoke.mjs",
    "preview": "node preview.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "express": "^4.19.2",
    "mongoose": "^9.1.3",
    "puppeteer-core": "^23.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "simple-icons": "^16.28.0",
    "typescript": "^5"
  }
}
